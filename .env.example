# =============================================================
# PROJECT MORPHEUS — Environment Configuration
# =============================================================
# Copy this file to .env and fill in production values.
# =============================================================

# --- PostgreSQL Database ---
DB_USER=morpheus_admin
DB_PASSWORD=morpheus_secure_pass
DB_HOST=postgres
DB_PORT=5432
DB_NAME=morpheus_db

# --- Redis Broker ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI Model Configuration (Ollama endpoints) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEXT_MODEL_NAME=qwen2.5:3b
VISION_MODEL_NAME=moondream:latest

# --- JWT Authentication (DAEDALUS) ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- SuperAdmin Bootstrap Credentials ---
SUPERADMIN_USERNAME=morpheus
SUPERADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# --- System ---
ENVIRONMENT=development
LOG_LEVEL=INFO
