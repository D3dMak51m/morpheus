# Copy this file to .env and fill in production values.
# =============================================================

# --- PostgreSQL Database ---
DB_USER=morpheus_admin
DB_PASSWORD=morpheus_secure_pass
DB_HOST=postgres
DB_PORT=5432
DB_NAME=morpheus_db

# --- Redis Broker ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI Model Configuration (Ollama endpoints) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEXT_MODEL_NAME=qwen2.5:3b
VISION_MODEL_NAME=moondream:latest

# --- JWT Authentication (DAEDALUS) ---
JWT_SECRET_KEY=4cc45e5465daf364742539eef739ee67671c52bc4455c1c7aaa89bbfa35e2773
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- SuperAdmin Bootstrap Credentials ---
SUPERADMIN_USERNAME=morpheus
SUPERADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# --- System ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Internal Microservices ---
MUNINN_BASE_URL=http://muninn:8002
